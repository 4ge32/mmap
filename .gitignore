# build artifacts
/build/
*.o

# generated test reports (JUnit XML)
/reports/

# generated Pages dashboard
/site/

# python caches (from tooling like gen_dashboard.py)
__pycache__/
*.pyc

# bootstrap marker (session-local)
/.bootstrap-done

# Frama-C session/state
/.frama-c/
*.sav

# WP prover cache (regenerable, environment-specific). The durable proof
# artifact is proofs/wp_session/script/, which IS tracked.
/proofs/wp_session/cache/
/proofs/wp_session/script/.marks/
